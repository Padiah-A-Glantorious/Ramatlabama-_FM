# Dependencies
node_modules/
server/node_modules/

# Runtime data — keep credentials & editable content OUT of the repo.
# These are generated fresh on the server from defaults / env vars.
server/users.json
server/content.json
server/chat.json
server/adverts.json
server/promos.json
server/adverts/
server/promos/
# login sessions (secret tokens)
server/sessions.json
# fill-in music library (songs are uploaded on the live server, not committed)
server/music.json
server/music/
# any stray backups from the corruption-safe loader
server/*.corrupt-*.bak

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
